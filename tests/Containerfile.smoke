# Containerfile.smoke - "can this build a machine?" smoke test for cosmikase.
#
# It runs the real bootstrap (install.sh) in CI mode on a clean Ubuntu 24.04
# image as a non-root user with sudo, then the default command asserts that the
# machine was actually configured (see tests/container-smoke-assert.sh).
#
# CI mode (COSMIKASE_CI=1) keeps the build fast and headless: install.sh applies
# chezmoi and the apt "core" packages but skips flatpak/snap/GUI/runtime steps.
#
# Build: docker build -f tests/Containerfile.smoke -t cosmikase-smoke .
# Run:   docker run --rm cosmikase-smoke
# (Normally driven by tests/container-smoke.sh, which auto-detects docker/podman.)

FROM ubuntu:24.04

LABEL org.opencontainers.image.title="cosmikase-smoke"
LABEL org.opencontainers.image.description="Smoke test: install.sh on a clean Ubuntu 24.04"

# Non-interactive apt + headless CI bootstrap mode.
ENV DEBIAN_FRONTEND=noninteractive
ENV COSMIKASE_CI=1

# Minimal bootstrap deps. install.sh installs its own prerequisites (curl, git,
# python3-yaml, chezmoi); we only need sudo + a non-root user for it to target.
RUN apt-get update \
    && apt-get install -y --no-install-recommends sudo ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create a passwordless-sudo non-root user (install.sh must not run as root).
RUN useradd --create-home --shell /bin/bash tester \
    && echo 'tester ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/tester \
    && chmod 0440 /etc/sudoers.d/tester

USER tester
WORKDIR /home/tester/cosmikase

# Copy the repository (build context = repo root; see .dockerignore).
COPY --chown=tester:tester . /home/tester/cosmikase

# Run the real bootstrap in CI mode. This is where the machine gets built;
# a failure here fails the image build with a clear signal.
RUN COSMIKASE_CI=1 ./install.sh

# Default command verifies the applied state.
CMD ["bash", "tests/container-smoke-assert.sh"]
