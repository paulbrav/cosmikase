# Example environment variables. The shell rc no longer auto-sources any secrets
# file (chezmoi owns dot_bashrc and does not read this file); each tool reads its
# own key from its own config/keyring. This is only a reference of what the tools
# below expect — export what you need from your own private, git-ignored env.

# Exa.ai API key — read from the environment by the exa-launcher plugin.
EXA_API_KEY=your_exa_api_key_here

# Anthropic API key — Claude Code stores its own auth; set only if you export it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key — used by codex/cursor; they manage their own auth.
OPENAI_API_KEY=your_openai_api_key_here
