#!/usr/bin/env bash
# cosmikase-theme-terminal - Reload terminal emulators after a theme change.
# Cosmikase ships two terminals: ghostty (quick-terminal dropdown) and
# cosmic-term (daily driver). ghostty reloads its config on SIGUSR1; cosmic-term
# watches its config via inotify and reloads automatically. Kitty and Alacritty
# were removed from cosmikase, so they are not handled here.
set -euo pipefail

# Source shared library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/cosmikase-lib.sh
source "$SCRIPT_DIR/cosmikase-lib.sh"

usage() {
    echo "Usage: $(basename "$0") [options]"
    echo ""
    echo "Reload running cosmikase terminals after a theme change."
    echo ""
    echo "Options:"
    echo "  --quiet, -q    Suppress output"
    echo "  -h, --help     Show this help message"
    echo ""
    echo "Terminals:"
    echo "  - ghostty      (SIGUSR1 reload)"
    echo "  - cosmic-term  (auto-reload via inotify)"
}

QUIET=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --quiet|-q)
            QUIET=true
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            exit 1
            ;;
    esac
done

log "Reloading terminal emulators..."

# ghostty reloads its configuration when sent SIGUSR1.
if pgrep -x ghostty >/dev/null 2>&1; then
    if pkill -USR1 -x ghostty 2>/dev/null; then
        log "  - Reloaded ghostty"
    else
        log "  - Failed to reload ghostty"
    fi
else
    log "  - ghostty not running"
fi

# cosmic-term watches its config file with inotify and reloads on its own.
if pgrep -x cosmic-term >/dev/null 2>&1; then
    log "  - cosmic-term running (auto-reloads via inotify)"
fi

log "Terminal reload complete!"
