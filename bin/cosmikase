#!/usr/bin/env bash
# cosmikase — interactive menu for the Pop!_OS / COSMIC environment.
# Uses gum when available; falls back to a plain `select` menu otherwise.
set -euo pipefail

# Resolve the real script location so this works both from the repo and from the
# ~/.local/bin symlink installed by run_before_05-install-cosmikase.
REAL="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$REAL")"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
INSTALL_SH="$REPO_DIR/install.sh"
THEMES_DIR="${THEMES_DIR:-$HOME/.local/share/cosmikase/themes}"

have() { command -v "$1" >/dev/null 2>&1; }

# Locate a sibling cosmikase-* helper (script dir first, then PATH).
helper() {
    if [ -x "$SCRIPT_DIR/$1" ]; then echo "$SCRIPT_DIR/$1"; elif have "$1"; then command -v "$1"; fi
}

banner() {
    cat <<'EOF'
     ██████╗ ██████╗ ███████╗███╗   ███╗██╗██╗  ██╗ █████╗ ███████╗███████╗
    ██╔════╝██╔═══██╗██╔════╝████╗ ████║██║██║ ██╔╝██╔══██╗██╔════╝██╔════╝
    ██║     ██║   ██║███████╗██╔████╔██║██║█████╔╝ ███████║███████╗█████╗
    ██║     ██║   ██║╚════██║██║╚██╔╝██║██║██╔═██╗ ██╔══██║╚════██║██╔══╝
    ╚██████╗╚██████╔╝███████║██║ ╚═╝ ██║██║██║  ██╗██║  ██║███████║███████╗
     ╚═════╝ ╚═════╝ ╚══════╝╚═╝     ╚═╝╚═╝╚═╝  ╚═╝╚═╝  ╚═╝╚══════╝╚══════╝
                          COSMIC Omakase for Pop!_OS
EOF
    echo
}

# ── Actions ──────────────────────────────────────────────────────────────────
do_preflight() { local h; h="$(helper cosmikase-preflight)"; [ -n "$h" ] && "$h" || echo "cosmikase-preflight not found"; }
do_install()   { if [ -x "$INSTALL_SH" ]; then "$INSTALL_SH"; else echo "install.sh not found at $INSTALL_SH"; fi; }
do_apply()     { if have chezmoi; then chezmoi apply; else echo "chezmoi not installed (run Install/Update system first)"; fi; }
do_update()    { local h; h="$(helper cosmikase-update)"; [ -n "$h" ] && "$h" || echo "cosmikase-update not found"; }
do_databases() { local h; h="$(helper cosmikase-databases)"; [ -n "$h" ] && "$h" || echo "cosmikase-databases not found"; }

do_theme() {
    local theme_cmd; theme_cmd="$(helper cosmikase-theme)"
    if [ -z "$theme_cmd" ]; then echo "cosmikase-theme not found"; return; fi
    if [ -d "$THEMES_DIR" ] && have gum; then
        local choice
        choice="$(find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | gum choose || true)"
        [ -n "$choice" ] && "$theme_cmd" "$choice"
    else
        # Let cosmikase-theme present its own picker.
        "$theme_cmd"
    fi
}

# Menu entry labels (order matters).
LABELS=(
    "Preflight (hardware check)"
    "Install / Update system"
    "Apply dotfiles"
    "Theme picker"
    "Update everything"
    "Databases"
    "Quit"
)

dispatch() {
    case "$1" in
        "Preflight (hardware check)") do_preflight ;;
        "Install / Update system")    do_install ;;
        "Apply dotfiles")             do_apply ;;
        "Theme picker")               do_theme ;;
        "Update everything")          do_update ;;
        "Databases")                  do_databases ;;
        "Quit")                       return 1 ;;
    esac
    return 0
}

main() {
    banner
    while true; do
        local choice
        if have gum; then
            choice="$(printf '%s\n' "${LABELS[@]}" | gum choose || echo Quit)"
        else
            echo "Select an option:"
            local PS3="> "
            select choice in "${LABELS[@]}"; do
                [ -n "${choice:-}" ] && break
            done
            choice="${choice:-Quit}"
        fi
        dispatch "$choice" || break
        echo
        echo "Press any key to return to the menu…"
        read -r -n 1 _ || true
        echo
    done
}

main "$@"
