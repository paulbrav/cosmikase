#!/usr/bin/env bash
# cosmikase-update — update everything installed on the system.
# apt + flatpak + language runtimes + firmware. Ghostty is an apt package now
# (ppa:mkasberg/ghostty-ubuntu), so it updates with apt — no source rebuild.
set -euo pipefail

step() { echo; echo "==> $*"; }

# ── System packages ──────────────────────────────────────────────────────────
step "apt packages"
sudo apt-get update
sudo apt-get full-upgrade -y
sudo apt-get autoremove -y

if command -v flatpak >/dev/null 2>&1; then
    step "flatpak apps"
    flatpak update -y || true
fi

# ── Language runtimes & package managers ─────────────────────────────────────
if command -v rustup >/dev/null 2>&1; then
    step "rust toolchain"
    rustup update || true
fi

if command -v uv >/dev/null 2>&1; then
    step "uv + uv tools"
    uv self update || echo "  (uv self update unavailable; may be system-managed)"
    uv tool upgrade --all || true
fi

if command -v bun >/dev/null 2>&1; then
    step "bun"
    bun upgrade || true
fi

if command -v juliaup >/dev/null 2>&1; then
    step "julia"
    juliaup update || true
fi

if command -v npm >/dev/null 2>&1; then
    step "npm globals"
    if [[ "$(npm config get prefix 2>/dev/null)" == /usr* ]]; then
        sudo npm update -g || true
    else
        npm update -g || true
    fi
fi

# ── Firmware ─────────────────────────────────────────────────────────────────
if command -v fwupdmgr >/dev/null 2>&1; then
    step "firmware"
    sudo fwupdmgr refresh --force 2>/dev/null || true
    sudo fwupdmgr get-updates 2>/dev/null || echo "  No firmware updates available."
    echo "  To install firmware updates: sudo fwupdmgr update"
fi

echo
echo "==> Update complete."
