#!/usr/bin/env bash
# cosmikase-theme-cosmic - Apply theme to COSMIC desktop
# This script applies theme colors, wallpaper, and terminal settings to COSMIC
set -euo pipefail

# Source shared library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/cosmikase-lib.sh
source "$SCRIPT_DIR/cosmikase-lib.sh"

THEMES_DIR="$(find_themes_dir)"

usage() {
    echo "Usage: $(basename "$0") <theme-name> [options]"
    echo ""
    echo "Apply a theme to COSMIC desktop (wallpaper, colors, terminal, dark/light mode)."
    echo ""
    echo "Options:"
    echo "  --no-wallpaper  Skip wallpaper change"
    echo "  --no-colors     Skip color theme application"
    echo "  --no-terminal   Skip terminal color scheme"
    echo "  --quiet, -q     Suppress output"
    echo "  -h, --help      Show this help message"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") catppuccin"
    echo "  $(basename "$0") tokyo-night --no-wallpaper"
}

# Parse arguments (shared scaffold in cosmikase-lib.sh + this script's flags).
APPLY_WALLPAPER=true
APPLY_COLORS=true
APPLY_TERMINAL=true

parse_script_flag() {
    case "$1" in
        --no-wallpaper) APPLY_WALLPAPER=false ;;
        --no-colors)    APPLY_COLORS=false ;;
        --no-terminal)  APPLY_TERMINAL=false ;;
        *) return 1 ;;
    esac
    return 0
}

parse_common_args "$@"

# Require theme
require_theme "$THEME" "$THEMES_DIR" || exit 1

# Check if COSMIC is available
if [[ ! -d "$HOME/.config/cosmic" ]]; then
    log "COSMIC config directory not found, skipping COSMIC theming"
    exit 0
fi

log "Applying COSMIC theme: $THEME"

# Determine if this is a light theme. Dark/light is declared by cursor.json's
# `light` flag (item 4.4 — the standalone light.mode marker file is gone). jq
# prints lowercase `true`, python prints capitalised `True`; accept both.
IS_LIGHT=false
if [[ -f "$THEME_PATH/cursor.json" ]]; then
    light_flag="$(parse_json "$THEME_PATH/cursor.json" light)"
    if [[ "$light_flag" == "true" ]] || [[ "$light_flag" == "True" ]]; then
        IS_LIGHT=true
    fi
fi

# Write the COSMIC config files directly (item 2.7): three independent guarded
# writes, no tmpdir staging and no doubled copy. COSMIC watches these files with
# inotify and reloads on its own, so a plain write is what the old tmpdir dance
# ultimately did anyway — just without the false "atomic" label.
apply_cosmic_configs() {
    # Dark/light mode: prefer the cosmic-config CLI, else write the file directly.
    local mode_dir="$HOME/.config/cosmic/com.system76.CosmicTheme.Mode/v1"
    local is_dark="true"
    [[ "$IS_LIGHT" == "true" ]] && is_dark="false"
    if command -v cosmic-config >/dev/null 2>&1; then
        cosmic-config set com.system76.CosmicTheme.Mode/v1 is_dark "$is_dark"
        log "  - Set COSMIC mode via cosmic-config"
    else
        mkdir -p "$mode_dir"
        echo "$is_dark" > "$mode_dir/is_dark"
        log "  - Set COSMIC mode via file write"
    fi

    # Colour theme (Light or Dark variant directory).
    if [[ "$APPLY_COLORS" == "true" ]] && [[ -f "$THEME_PATH/cosmic.ron" ]]; then
        local theme_dir
        if [[ "$IS_LIGHT" == "true" ]]; then
            theme_dir="$HOME/.config/cosmic/com.system76.CosmicTheme.Light/v1"
        else
            theme_dir="$HOME/.config/cosmic/com.system76.CosmicTheme.Dark/v1"
        fi
        mkdir -p "$theme_dir"
        cp "$THEME_PATH/cosmic.ron" "$theme_dir/theme"
        log "  - Applied COSMIC color theme"
    fi

    # Terminal colour scheme.
    if [[ "$APPLY_TERMINAL" == "true" ]] && [[ -f "$THEME_PATH/cosmic-term.ron" ]]; then
        local term_dir="$HOME/.config/cosmic/com.system76.CosmicTerm/v1"
        mkdir -p "$term_dir"
        cp "$THEME_PATH/cosmic-term.ron" "$term_dir/color_scheme"
        log "  - Applied COSMIC terminal color scheme"
    fi
}

apply_cosmic_configs

# Find the first wallpaper image in a backgrounds dir (ignores .gitkeep).
first_wallpaper() {
    find "$1" -maxdepth 1 -type f \
        \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) \
        2>/dev/null | sort | head -1
}

# Set COSMIC wallpaper. Wallpapers may live in the repo theme dir (source
# "unknown") or, for removed-source themes, in the fetched runtime dir. If
# neither has images, ask cosmikase-wallpapers to fetch them (offline-safe).
if [[ "$APPLY_WALLPAPER" == "true" ]]; then
    RUNTIME_BG="${XDG_DATA_HOME:-$HOME/.local/share}/cosmikase/backgrounds/$THEME"
    WALLPAPER=""
    [[ -d "$RUNTIME_BG" ]] && WALLPAPER=$(first_wallpaper "$RUNTIME_BG")
    if [[ -z "$WALLPAPER" ]] && [[ -d "$THEME_PATH/backgrounds" ]]; then
        WALLPAPER=$(first_wallpaper "$THEME_PATH/backgrounds")
    fi
    if [[ -z "$WALLPAPER" ]]; then
        WALLPAPERS_HELPER=$(find_helper "cosmikase-wallpapers")
        if [[ -n "$WALLPAPERS_HELPER" ]]; then
            log "  - Fetching wallpapers for $THEME..."
            "$WALLPAPERS_HELPER" fetch "$THEME" >/dev/null 2>&1 || true
            [[ -d "$RUNTIME_BG" ]] && WALLPAPER=$(first_wallpaper "$RUNTIME_BG")
        fi
    fi
    if [[ -n "$WALLPAPER" ]]; then
        WALLPAPER=$(realpath "$WALLPAPER")
        COSMIC_BG_DIR="$HOME/.config/cosmic/com.system76.CosmicBackground/v1"
        mkdir -p "$COSMIC_BG_DIR"
        
        # Write proper RON format for wallpaper config
        cat > "$COSMIC_BG_DIR/all" << EOF
(
    output: "all",
    source: Path("$WALLPAPER"),
    filter_by_theme: false,
    rotation_frequency: 3600,
    filter_method: Lanczos,
    scaling_mode: Zoom,
    sampling_method: Alphanumeric,
)
EOF
        # Remove spurious source file if it exists
        rm -f "$COSMIC_BG_DIR/source"
        log "  - Set COSMIC wallpaper: $(basename "$WALLPAPER")"
    else
        log "  - No wallpaper found in theme"
    fi
fi

# COSMIC uses inotify to watch config files - changes apply automatically
log "COSMIC theme '$THEME' applied successfully!"
log "Note: COSMIC auto-reloads config via inotify"
