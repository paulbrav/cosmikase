#!/usr/bin/env bash
# cosmikase-theme-cursor - Apply theme to Cursor, VS Code, and Antigravity
# This script reads cursor.json from a theme and applies it to VS Code forks
set -euo pipefail

# Source shared library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/cosmikase-lib.sh
source "$SCRIPT_DIR/cosmikase-lib.sh"

THEMES_DIR="$(find_themes_dir)"

# Single per-editor descriptor table (item 2.6): display|cmd|configdir|pgrep.
# The apply loop uses display/cmd/configdir; the running-editor loop uses
# display/pgrep. VS Code's pgrep pattern is anchored to the bare process name
# ^code$ so it does not match the many command lines that merely contain "code";
# the others match either case. (The old WM_CLASS column drove the xdotool
# auto-reload branch, which item 2.8 deleted, so it is gone with it.)
EDITORS=(
    "Cursor|cursor|$HOME/.config/Cursor|[Cc]ursor"
    "VS Code|code|$HOME/.config/Code|^code$"
    "Antigravity|antigravity|$HOME/.config/Antigravity|[Aa]ntigravity"
)

usage() {
    echo "Usage: $(basename "$0") <theme-name> [options]"
    echo ""
    echo "Apply a theme to Cursor, VS Code, and Antigravity by updating settings"
    echo "and installing extensions."
    echo ""
    echo "Options:"
    echo "  --no-install    Skip extension installation"
    echo "  --no-reload     Skip reload attempt"
    echo "  --only <name>   Only update one editor (cursor|code|antigravity)"
    echo "  --quiet, -q     Suppress output"
    echo "  -h, --help      Show this help message"
    echo ""
    echo "Supported editors:"
    echo "  - Cursor       (~/.config/Cursor/User/settings.json)"
    echo "  - VS Code      (~/.config/Code/User/settings.json)"
    echo "  - Antigravity  (~/.config/Antigravity/User/settings.json)"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") catppuccin"
    echo "  $(basename "$0") tokyo-night --no-reload"
    echo "  $(basename "$0") gruvbox --only cursor"
}

# Parse arguments (shared scaffold in cosmikase-lib.sh + this script's flags).
INSTALL_EXTENSION=true
ATTEMPT_RELOAD=true
ONLY=""

parse_script_flag() {
    case "$1" in
        --no-install) INSTALL_EXTENSION=false ;;
        --no-reload)  ATTEMPT_RELOAD=false ;;
        --only)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --only requires an editor name" >&2
                usage
                exit 1
            fi
            ONLY="$2"
            SHIFT_COUNT=2
            ;;
        *) return 1 ;;
    esac
    return 0
}

parse_common_args "$@"

# Require theme
require_theme "$THEME" "$THEMES_DIR" || exit 1

CURSOR_JSON="$THEME_PATH/cursor.json"

# Check for cursor.json
if [[ ! -f "$CURSOR_JSON" ]]; then
    log "No cursor.json found for theme '$THEME', skipping editor configuration"
    exit 0
fi

COLOR_THEME=$(parse_json "$CURSOR_JSON" "colorTheme")
EXTENSION_ID=$(parse_json "$CURSOR_JSON" "extension")

if [[ -z "$COLOR_THEME" ]]; then
    echo "Error: No colorTheme found in $CURSOR_JSON" >&2
    exit 1
fi

log "Applying editor theme: $COLOR_THEME"

# --only <name> filter: does this editor match the requested name?
only_selected() {
    local display="${1,,}" cmd="${2,,}" want="${ONLY,,}"
    [[ "$want" == "$display" || "$want" == "$cmd" ]]
}

# Install extension for each editor
install_extension() {
    local cmd="$1"
    local app_name="$2"

    if [[ -z "$cmd" ]] || [[ -z "$EXTENSION_ID" ]]; then
        return
    fi

    log "  - Checking extension for $app_name: $EXTENSION_ID"

    # Check if extension is already installed
    if ! "$cmd" --list-extensions 2>/dev/null | grep -qi "^${EXTENSION_ID}$"; then
        log "  - Installing extension for $app_name: $EXTENSION_ID"
        if "$cmd" --install-extension "$EXTENSION_ID" --force >/dev/null 2>&1; then
            log "  - Extension installed successfully in $app_name"
        else
            log "  - Warning: Failed to install extension in $app_name (may already exist or be unavailable)"
        fi
    else
        log "  - Extension already installed in $app_name"
    fi
}

# Update settings.json for a VS Code fork. This helper is the SOLE writer of
# editor theme settings (there is no longer a chezmoi settings.json template —
# item 4.1): it merges colorTheme, preferred dark/light, color customizations
# and token colors read straight from the theme's cursor.json into the user's
# existing settings, preserving every other key.
update_settings() {
    local settings_file="$1"
    local app_name="$2"

    if [[ ! -d "$(dirname "$settings_file")" ]]; then
        log "  - $app_name config directory not found, skipping"
        return 1
    fi

    # Create settings file if it doesn't exist
    if [[ ! -f "$settings_file" ]]; then
        mkdir -p "$(dirname "$settings_file")"
        echo '{}' > "$settings_file"
    fi

    # Merge the theme into the existing settings using jq or python. Both paths
    # produce identical output so the no-jq fallback cannot drift.
    if command -v jq >/dev/null 2>&1; then
        local tmp_file
        tmp_file=$(mktemp)
        if jq --slurpfile c "$CURSOR_JSON" '
              ($c[0]) as $t
            | ($t.light // false) as $light
            | ($t.colors // {}) as $col
            | . + {
                "window.commandCenter": true,
                "workbench.colorTheme": $t.colorTheme,
                "workbench.preferredDarkColorTheme":
                    (if $light then "Cursor Dark Midnight" else $t.colorTheme end),
                "workbench.preferredLightColorTheme":
                    (if $light then $t.colorTheme else "Cursor Light" end),
                "workbench.colorCustomizations": {
                    "editor.background": $col.background,
                    "sideBar.background": ($col.sidebar // $col.background),
                    "terminal.background": ($col.terminal // $col.background),
                    "activityBar.background": ($col.sidebar // $col.background)
                }
              }
            | if ($t.tokenColors != null)
              then . + {"editor.tokenColorCustomizations": {"textMateRules": $t.tokenColors}}
              else . end
        ' "$settings_file" > "$tmp_file" 2>/dev/null; then
            mv "$tmp_file" "$settings_file"
        else
            rm -f "$tmp_file"
            log "  - Warning: could not update $app_name settings (invalid JSON?)"
            return 1
        fi
    elif command -v python3 >/dev/null 2>&1; then
        if ! CURSOR_JSON="$CURSOR_JSON" SETTINGS_FILE="$settings_file" python3 - <<'EOF'
import json
import os

settings_file = os.environ["SETTINGS_FILE"]
cursor_json = os.environ["CURSOR_JSON"]

try:
    with open(settings_file) as f:
        settings = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    settings = {}

with open(cursor_json) as f:
    t = json.load(f)

light = t.get("light", False)
col = t.get("colors", {})
bg = col.get("background")

settings["window.commandCenter"] = True
settings["workbench.colorTheme"] = t["colorTheme"]
settings["workbench.preferredDarkColorTheme"] = (
    "Cursor Dark Midnight" if light else t["colorTheme"]
)
settings["workbench.preferredLightColorTheme"] = (
    t["colorTheme"] if light else "Cursor Light"
)
settings["workbench.colorCustomizations"] = {
    "editor.background": bg,
    "sideBar.background": col.get("sidebar", bg),
    "terminal.background": col.get("terminal", bg),
    "activityBar.background": col.get("sidebar", bg),
}
if t.get("tokenColors") is not None:
    settings["editor.tokenColorCustomizations"] = {"textMateRules": t["tokenColors"]}

with open(settings_file, "w") as f:
    json.dump(settings, f, indent=4)
EOF
        then
            log "  - Warning: could not update $app_name settings"
            return 1
        fi
    else
        echo "Error: Neither jq nor python3 available for JSON editing" >&2
        return 1
    fi

    log "  - Updated $app_name settings"
    return 0
}

# Apply theme to each editor (loop 1). Track which editors were updated so the
# reload notification only names the ones we actually touched.
UPDATED_EDITORS=()

for row in "${EDITORS[@]}"; do
    IFS='|' read -r display cmd configdir _ <<<"$row"
    if [[ -n "$ONLY" ]] && ! only_selected "$display" "$cmd"; then
        continue
    fi
    [[ -d "$configdir" ]] || continue

    settings="$configdir/User/settings.json"
    editor_cmd="$(command -v "$cmd" 2>/dev/null || true)"

    if [[ "$INSTALL_EXTENSION" == "true" ]] && [[ -n "$editor_cmd" ]]; then
        install_extension "$editor_cmd" "$display"
    fi
    if update_settings "$settings" "$display"; then
        UPDATED_EDITORS+=("$display")
    fi
done

# Detect which updated editors are running and notify the user to reload them
# (loop 2). COSMIC is Wayland-only, so there is no window-manager keystroke
# injection — item 2.8 removed the unreachable X11/xdotool auto-reload path.
if [[ "$ATTEMPT_RELOAD" == "true" ]] && [[ ${#UPDATED_EDITORS[@]} -gt 0 ]]; then
    running_editors=()
    for row in "${EDITORS[@]}"; do
        IFS='|' read -r display _ _ pattern <<<"$row"
        [[ " ${UPDATED_EDITORS[*]} " == *" $display "* ]] || continue
        if pgrep -f "$pattern" >/dev/null 2>&1; then
            running_editors+=("$display")
        fi
    done

    if [[ ${#running_editors[@]} -gt 0 ]]; then
        editors_list=$(IFS=', '; echo "${running_editors[*]}")
        notify "Theme Applied" "Theme set to $COLOR_THEME. Press Ctrl+Shift+P → 'Developer: Reload Window' in: $editors_list"
        log "  - Running editors: $editors_list"
        log "  - Reload with: Ctrl+Shift+P → 'Developer: Reload Window'"
    else
        log "  - No editors running, theme will apply on next launch"
    fi
fi

if [[ ${#UPDATED_EDITORS[@]} -gt 0 ]]; then
    editors_list=$(IFS=', '; echo "${UPDATED_EDITORS[*]}")
    log "Editor theme '$COLOR_THEME' applied to: $editors_list"
else
    log "No editors configured, skipping"
fi
