#!/usr/bin/env bash
# cosmikase-wallpapers - fetch/verify theme wallpapers described in
# themes/wallpapers.yaml. Wallpapers with a known upstream source were removed
# from git to keep the repo small; this restores them (sha256-verified) into
#   ${XDG_DATA_HOME:-$HOME/.local/share}/cosmikase/backgrounds/<theme>/
# Wallpapers whose source is "unknown" stay in the repo tree and are not fetched.
#
# Usage:
#   cosmikase-wallpapers fetch [theme]     download missing wallpapers (all themes, or one)
#   cosmikase-wallpapers verify [theme]    check sha256 of present wallpapers
#   cosmikase-wallpapers list [theme]      show fetchable wallpapers and their state
#
# Offline-safe: fetch warns and continues if the network is unavailable.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/cosmikase-lib.sh
source "$SCRIPT_DIR/cosmikase-lib.sh"

RUNTIME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/cosmikase/backgrounds"

# Locate wallpapers.yaml (env override, themes dir, or script-relative repo).
find_manifest() {
    if [[ -n "${COSMIKASE_WALLPAPERS_MANIFEST:-}" ]] && [[ -f "$COSMIKASE_WALLPAPERS_MANIFEST" ]]; then
        echo "$COSMIKASE_WALLPAPERS_MANIFEST"; return 0
    fi
    local themes_dir
    themes_dir="$(find_themes_dir)"
    if [[ -f "$themes_dir/wallpapers.yaml" ]]; then
        echo "$themes_dir/wallpapers.yaml"; return 0
    fi
    if [[ -f "$SCRIPT_DIR/../themes/wallpapers.yaml" ]]; then
        (cd "$SCRIPT_DIR/../themes" && echo "$PWD/wallpapers.yaml"); return 0
    fi
    return 1
}

# Emit TSV rows "theme<TAB>filename<TAB>sha256<TAB>in_tree<TAB>url" for the
# requested theme (or all). Requires python3 + PyYAML.
manifest_rows() {
    local manifest="$1" want_theme="${2:-}"
    python3 - "$manifest" "$want_theme" <<'PY'
import sys
try:
    import yaml
except ImportError:
    sys.stderr.write("error: python3 PyYAML is required (pip install pyyaml / apt install python3-yaml)\n")
    sys.exit(3)
manifest, want = sys.argv[1], sys.argv[2]
with open(manifest) as fh:
    data = yaml.safe_load(fh) or {}
for theme, records in (data.get("themes") or {}).items():
    if want and theme != want:
        continue
    for rec in records or []:
        fn = rec.get("filename", "")
        sha = rec.get("sha256", "")
        in_tree = "true" if rec.get("in_tree") else "false"
        url = rec.get("url", "") or ""
        print("\t".join([theme, fn, sha, in_tree, url]))
PY
}

sha_of() { sha256sum "$1" | cut -d' ' -f1; }

cmd_fetch() {
    local want_theme="${1:-}" manifest failures=0 fetched=0 skipped=0
    manifest="$(find_manifest)" || { echo "error: wallpapers.yaml not found" >&2; return 1; }

    if ! command -v curl >/dev/null 2>&1; then
        log "curl not available; cannot fetch wallpapers (offline-safe skip)"
        return 0
    fi

    local theme fn sha in_tree url dest tmp got
    while IFS=$'\t' read -r theme fn sha in_tree url; do
        [[ "$in_tree" == "true" ]] && continue      # stays in repo, nothing to fetch
        [[ -z "$url" ]] && continue                 # broken/unknown, no source
        dest="$RUNTIME_DIR/$theme/$fn"
        if [[ -f "$dest" ]] && [[ "$(sha_of "$dest")" == "$sha" ]]; then
            skipped=$((skipped + 1)); continue
        fi
        mkdir -p "$RUNTIME_DIR/$theme"
        tmp="$(mktemp "$RUNTIME_DIR/$theme/.$fn.XXXXXX")"
        if curl -fsSL --max-time 120 "$url" -o "$tmp" 2>/dev/null; then
            got="$(sha_of "$tmp")"
            if [[ "$got" == "$sha" ]]; then
                mv -f "$tmp" "$dest"
                chmod 0644 "$dest"
                log "  fetched $theme/$fn"
                fetched=$((fetched + 1))
            else
                rm -f "$tmp"
                echo "  sha256 mismatch for $theme/$fn (got ${got:0:12}, want ${sha:0:12})" >&2
                failures=$((failures + 1))
            fi
        else
            rm -f "$tmp"
            log "  could not download $theme/$fn (offline?)"
        fi
    done < <(manifest_rows "$manifest" "$want_theme")

    log "wallpapers: $fetched fetched, $skipped already present"
    [[ "$failures" -eq 0 ]]
}

cmd_verify() {
    local want_theme="${1:-}" manifest bad=0 ok=0 missing=0
    manifest="$(find_manifest)" || { echo "error: wallpapers.yaml not found" >&2; return 1; }

    local themes_dir; themes_dir="$(find_themes_dir)"
    local theme fn sha in_tree url path got
    while IFS=$'\t' read -r theme fn sha in_tree url; do
        if [[ "$in_tree" == "true" ]]; then
            path="$themes_dir/$theme/backgrounds/$fn"
        else
            path="$RUNTIME_DIR/$theme/$fn"
        fi
        if [[ ! -f "$path" ]]; then
            [[ "$in_tree" == "true" ]] && { echo "MISSING (in-tree) $theme/$fn" >&2; bad=$((bad + 1)); } \
                                       || missing=$((missing + 1))
            continue
        fi
        got="$(sha_of "$path")"
        if [[ "$got" == "$sha" ]]; then
            ok=$((ok + 1))
        else
            echo "MISMATCH $theme/$fn (got ${got:0:12}, want ${sha:0:12})" >&2
            bad=$((bad + 1))
        fi
    done < <(manifest_rows "$manifest" "$want_theme")

    echo "verify: $ok ok, $bad bad, $missing not-yet-fetched"
    [[ "$bad" -eq 0 ]]
}

cmd_list() {
    local want_theme="${1:-}" manifest
    manifest="$(find_manifest)" || { echo "error: wallpapers.yaml not found" >&2; return 1; }
    local theme fn sha in_tree url state
    while IFS=$'\t' read -r theme fn sha in_tree url; do
        if [[ "$in_tree" == "true" ]]; then
            state="in-repo"
        elif [[ -z "$url" ]]; then
            state="no-source"
        elif [[ -f "$RUNTIME_DIR/$theme/$fn" ]]; then
            state="fetched"
        else
            state="fetchable"
        fi
        printf '%-10s %-14s %s/%s\n' "$state" "$theme" "$theme" "$fn"
    done < <(manifest_rows "$manifest" "$want_theme")
}

usage() {
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        fetch)  cmd_fetch "${1:-}" ;;
        verify) cmd_verify "${1:-}" ;;
        list)   cmd_list "${1:-}" ;;
        -h|--help|help|"") usage ;;
        *) echo "unknown command: $sub" >&2; usage; return 1 ;;
    esac
}

main "$@"
