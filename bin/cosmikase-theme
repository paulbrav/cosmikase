#!/usr/bin/env bash
# cosmikase-theme - Switch themes through chezmoi.
#
# chezmoi is the single orchestrator (item 1.1): this script only validates the
# theme, records history, rewrites [data].theme, and runs `chezmoi apply`. The
# actual application (COSMIC, terminals, editors, per-app assets) is done once by
# the run_onchange_after_10-setup-theme hook, which fires because [data].theme
# changed. There is no second, unguarded application pass here anymore.
set -euo pipefail

# Find script directory for helper scripts
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source shared library
# shellcheck source=bin/cosmikase-lib.sh
source "$SCRIPT_DIR/cosmikase-lib.sh"

THEMES_DIR="$(find_themes_dir)"

# Active-theme pointer maintained by chezmoi (symlink_current); used to detect a
# same-theme re-select, where the run_onchange hook will not refire.
CURRENT_LINK="$HOME/.local/share/cosmikase/current"

usage() {
    echo "Usage: $(basename "$0") <theme-name> [options]"
    echo ""
    echo "Switch to a different theme by updating chezmoi data and reapplying"
    echo "dotfiles. chezmoi's post-apply hook performs the live theme update."
    echo ""
    echo "Options:"
    echo "  --rollback      Roll back to the previous theme"
    echo "  --quiet, -q     Suppress output from helper scripts"
    echo "  -h, --help      Show this help message"
    echo ""
    echo "Available themes:"
    if [[ -d "$THEMES_DIR" ]]; then
        for theme in "$THEMES_DIR"/*/; do
            [[ -d "$theme" ]] && echo "  - $(basename "$theme")"
        done
    else
        echo "  (themes directory not found - run 'make install' first)"
    fi
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") nord"
    echo "  $(basename "$0") tokyo-night"
    echo "  $(basename "$0") --rollback"
}

# Parse arguments
THEME=""
ROLLBACK=false
QUIET=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --rollback)
            ROLLBACK=true
            shift
            ;;
        --quiet|-q)
            QUIET=true
            shift
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage
            exit 1
            ;;
        *)
            if [[ -z "$THEME" ]]; then
                THEME="$1"
            else
                echo "Error: Multiple theme names provided" >&2
                usage
                exit 1
            fi
            shift
            ;;
    esac
done

# Handle rollback
if [[ "$ROLLBACK" == "true" ]]; then
    PREV=$(get_previous_theme)
    if [[ -z "$PREV" ]]; then
        echo "Error: No theme history found to roll back." >&2
        exit 1
    fi
    echo "Rolling back to: $PREV"
    THEME="$PREV"
fi

# Require theme argument
if [[ -z "$THEME" ]]; then
    usage
    exit 1
fi

require_theme "$THEME" "$THEMES_DIR" || exit 1

# Detect a same-theme re-select before we change anything: the currently active
# theme is whatever the chezmoi-managed `current` symlink points at.
CURRENT_THEME=""
if current_target="$(readlink "$CURRENT_LINK" 2>/dev/null)" && [[ -n "$current_target" ]]; then
    CURRENT_THEME="$(basename "$current_target")"
fi
SAME_THEME=false
[[ "$THEME" == "$CURRENT_THEME" ]] && SAME_THEME=true

echo "Switching to theme: $THEME"

# Save history
save_theme_history "$THEME"

# Require chezmoi
if ! command -v chezmoi >/dev/null 2>&1; then
    echo "Error: chezmoi not found. Please install chezmoi first." >&2
    echo "  curl -sfL https://get.chezmoi.io | sh" >&2
    exit 1
fi

# Update chezmoi data using the single-file helper for safe atomic TOML editing.
# cosmikase-chezmoi is a PEP 723 uv script (shebang runs it via uv), so guard.
echo "  - Updating chezmoi configuration..."
if ! command -v uv >/dev/null 2>&1; then
    echo "Error: 'uv' is required to update the chezmoi theme (bin/cosmikase-chezmoi)." >&2
    echo "  Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
    exit 1
fi
if ! "$SCRIPT_DIR/cosmikase-chezmoi" "$THEME" "$THEMES_DIR"; then
    echo "Error: Failed to update chezmoi configuration" >&2
    exit 1
fi

# Reapply dotfiles. When the theme changed this fires the run_onchange post-apply
# hook, which does the single live application. --force so the theme switch wins
# over any locally modified managed files.
echo "  - Applying dotfiles..."
chezmoi apply --force

# Same-theme re-select: [data].theme did not change, so run_onchange will not
# refire the hook. Apply the live helpers directly so the command is not a no-op.
# (This is the cheap re-select path, not the old unconditional Step 2.)
if [[ "$SAME_THEME" == "true" ]]; then
    echo ""
    echo "Theme unchanged; re-applying to running applications..."

    helper_args=("$THEME")
    [[ "$QUIET" == "true" ]] && helper_args+=("--quiet")

    for name in cosmikase-theme-cursor cosmikase-theme-cosmic; do
        helper="$(find_helper "$name")"
        if [[ -n "$helper" ]]; then
            THEMES_DIR="$THEMES_DIR" "$helper" "${helper_args[@]}" || true
        fi
    done

    term_helper="$(find_helper "cosmikase-theme-terminal")"
    if [[ -n "$term_helper" ]]; then
        if [[ "$QUIET" == "true" ]]; then
            "$term_helper" --quiet || true
        else
            "$term_helper" || true
        fi
    fi
fi

echo ""
echo "Theme '$THEME' applied successfully!"
