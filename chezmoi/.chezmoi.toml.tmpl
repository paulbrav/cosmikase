# chezmoi configuration template -> ~/.config/chezmoi/chezmoi.toml
#
# THE default theme is defined here and ONLY here: the literal "nord" below.
# On first interactive `chezmoi init` you are asked once (default: nord) and the
# answer is stored in the generated config and reused. When COSMIKASE_CI is set
# (the container test) the prompt is skipped and the default is used, since
# promptStringOnce cannot open a TTY. Change themes later with
# `cosmikase-theme <name>`, which rewrites [data].theme via bin/cosmikase-chezmoi.
{{/* NOTE: line above keeps its own trailing newline (no left-trim on the next
     directive) so the header comment cannot merge onto the `sourceDir` line. */}}
{{- $theme := "nord" -}}
{{- if hasKey . "theme" -}}
{{-   $theme = .theme -}}
{{- else if ne (env "COSMIKASE_CI") "1" -}}
{{-   $theme = promptStringOnce . "theme" "Default theme" "nord" -}}
{{- end -}}
{{- $font_family := "JetBrainsMono Nerd Font" -}}
{{- $font_size := 9 -}}
{{- $padding := 14 -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    # Repo root (parent of the chezmoi source dir). Templates and symlink_ entries
    # reach bin/ and themes/ through .repo_dir instead of the `joinPath
    # .chezmoi.sourceDir ".."` escape idiom.
    repo_dir = {{ dir .chezmoi.sourceDir | quote }}
    theme = {{ $theme | quote }}
    font_family = {{ $font_family | quote }}
    font_size = {{ $font_size }}
    padding = {{ $padding }}
