# Antigravity configuration
# The active theme's file is reached through the ~/.local/share/cosmikase/current
# symlink (re-pointed on every theme switch), so this file is theme-independent
# and never re-renders per theme (item 2.5). Editor colors are owned entirely by
# bin/cosmikase-theme-cursor now (item 4.1); the old [colors] block was dead.

[theme]
# Reference the theme file for Antigravity-specific styling
file = "{{ .chezmoi.homeDir }}/.local/share/cosmikase/current/antigravity.conf"
