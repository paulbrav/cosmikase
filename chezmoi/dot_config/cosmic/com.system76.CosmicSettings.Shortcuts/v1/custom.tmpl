// ~/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom
//
// Custom COSMIC keyboard shortcuts (owner muscle-memory), merged OVER the shipped
// defaults. Custom entries win on duplicate bindings.
// Generated by chezmoi from custom.tmpl — edits here are overwritten on `chezmoi apply`.
//
// FORMAT: RON map of Binding -> Action.
//   Binding: (modifiers: [Super|Ctrl|Alt|Shift ...], key: "<xkb-keysym-name>",
//             description: Some("..."))
//     - `key` is a bare string keysym NAME (xkbcommon, no KEY_ prefix):
//       letters lowercase ("t"), specials keep xkb spelling ("grave", "Escape").
//     - key/keycode/description are optional; modifiers required.
//   Action: System(<SystemAction>) | Spawn("<shell command>") | Close | Focus(..) ...
//     - Spawn runs `/bin/sh -c "<command>"` (shell-parsed; PATH inherited).
//
// Sources (verified 2026-07-16):
//   Binding/Action/Modifier/keysym:
//     https://github.com/pop-os/cosmic-settings-daemon/tree/master/config/src/shortcuts
//   System action -> command map (Terminal => cosmic-term, etc.):
//     https://github.com/pop-os/cosmic-settings-daemon/blob/master/data/system_actions.ron
//   Shipped defaults (Super+t/b/f/Escape already bound the same way):
//     https://github.com/pop-os/cosmic-comp/blob/master/data/keybindings.ron
//   Spawn exec (/bin/sh -c):
//     https://github.com/pop-os/cosmic-comp/blob/master/src/input/actions.rs
{
    // --- Already COSMIC defaults; re-declared to pin the owner's muscle memory ---
    // These match cosmic-comp/data/keybindings.ron exactly, so there is no behavior
    // change or conflict — they just guarantee the mapping regardless of upstream
    // default drift. System(Terminal) resolves to "cosmic-term" via system_actions.ron.

    (
        modifiers: [Super],
        key: "t",
        description: Some("Terminal (cosmic-term)"),
    ): System(Terminal),

    (
        modifiers: [Super],
        key: "b",
        description: Some("Web browser (default handler)"),
    ): System(WebBrowser),

    // COSMIC's nearest equivalent to "open files" is HomeFolder (xdg-open ~).
    (
        modifiers: [Super],
        key: "f",
        description: Some("Files (home folder)"),
    ): System(HomeFolder),

    (
        modifiers: [Super],
        key: "Escape",
        description: Some("Lock screen"),
    ): System(LockScreen),

    // --- New bindings (not in COSMIC defaults) ---

    // Super+E -> mail. GAP: COSMIC has no System(Mail); spawn the freedesktop
    // default mail handler. Change "xdg-email" to your mail client if desired.
    (
        modifiers: [Super],
        key: "e",
        description: Some("Mail (default handler)"),
    ): Spawn("xdg-email"),

    // Super+` (grave) -> drop-down terminal.
    // This compositor-level shortcut is the RELIABLE drop-down path on COSMIC:
    // ghostty's own `global:super+grave=toggle_quick_terminal` needs the XDG
    // GlobalShortcuts portal, which xdg-desktop-portal-cosmic does NOT implement
    // yet (its data/cosmic.portal lists only Access/FileChooser/Screenshot/
    // Settings/ScreenCast). See ~/.config/ghostty/config and bin/cosmikase-dropterm.
    // Absolute path is used because Spawn's /bin/sh may have a minimal PATH.
    (
        modifiers: [Super],
        key: "grave",
        description: Some("Drop-down terminal (cosmikase-dropterm)"),
    ): Spawn("{{ .chezmoi.homeDir }}/.local/bin/cosmikase-dropterm"),
{{- if lookPath "transclip" }}

    // Super+D -> dictation / clipboard-transcription toggle (transclip).
    // Emitted only because `transclip` is on PATH at apply time (private tool;
    // see docs/private-tools.md). Adjust the subcommand to match your transclip CLI.
    (
        modifiers: [Super],
        key: "d",
        description: Some("Dictation toggle (transclip)"),
    ): Spawn("transclip toggle"),
{{- end }}
}
