#!/usr/bin/env bash
# run_onchange_before_10-packages.sh — apt packages, flatpak, fonts, ghostty.
#
# This is a chezmoi run_onchange script: it re-runs whenever cosmikase.yaml
# changes (the hash below is part of the rendered content). The manifest is read
# through the one canonical reader bin/cosmikase-manifest (python3 + PyYAML). The
# manifest lives at the repo root, reached via the .repo_dir [data] key (the
# parent of the chezmoi source dir), resolved to an absolute path at apply.
#
# manifest-sha256: {{ include (joinPath .repo_dir "cosmikase.yaml") | sha256sum }}
#
# CI mode (COSMIKASE_CI=1): install ONLY apt.core, then stop — no gui/system,
# no flatpak, no fonts, no ghostty PPA. Keeps the container smoke test fast.
set -euo pipefail

MANIFEST="{{ .repo_dir }}/cosmikase.yaml"
MANIFEST_READER="{{ .repo_dir }}/bin/cosmikase-manifest"
CI="${COSMIKASE_CI:-0}"

[ -f "$MANIFEST" ] || { echo "manifest not found: $MANIFEST" >&2; exit 1; }

# The one canonical manifest reader serves every section (see cosmikase.yaml for
# the parse contract). `list <path> <field...>` emits installable entries, one
# per line, fields joined by the ASCII Unit Separator (0x1f).
manifest() { "$MANIFEST_READER" -m "$MANIFEST" "$@"; }

apt_install() { # install only packages not already present
    local want=("$@") missing=() p
    [ "${#want[@]}" -eq 0 ] && return 0
    for p in "${want[@]}"; do dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p"); done
    if [ "${#missing[@]}" -gt 0 ]; then
        echo "  apt install: ${missing[*]}"
        sudo apt-get install -y "${missing[@]}"
    fi
}

# ── core apt (always, incl. CI) ──────────────────────────────────────────────
echo "==> apt core packages"
sudo apt-get update -qq
mapfile -t core < <(manifest list apt.core name)
apt_install "${core[@]}"

if [ "$CI" = "1" ]; then
    echo "==> CI mode: skipping gui/system/flatpak/fonts/ghostty"
    exit 0
fi

# ── gui + system apt ─────────────────────────────────────────────────────────
echo "==> apt gui + system packages"
mapfile -t gui < <(manifest list apt.gui name)
mapfile -t system < <(manifest list apt.system name)
apt_install "${gui[@]}"
apt_install "${system[@]}"

# ── ghostty (quick-terminal) via the maintained ghostty-ubuntu PPA ───────────
# Keyed on membership of apt.ppa (installed one-by-one here, never in the batch).
if manifest list apt.ppa name | grep -qxF ghostty && ! command -v ghostty >/dev/null 2>&1; then
    echo "==> ghostty (ppa:mkasberg/ghostty-ubuntu)"
    dpkg -s software-properties-common >/dev/null 2>&1 || sudo apt-get install -y software-properties-common
    if ! grep -Rqs "mkasberg/ghostty-ubuntu" /etc/apt/sources.list.d/ 2>/dev/null; then
        sudo add-apt-repository -y ppa:mkasberg/ghostty-ubuntu
        sudo apt-get update -qq
    fi
    apt_install ghostty
fi

# ── flatpak (add flathub only if any app is enabled) ─────────────────────────
mapfile -t fpids < <(manifest list flatpak id)
if [ "${#fpids[@]}" -gt 0 ]; then
    echo "==> flatpak apps"
    dpkg -s flatpak >/dev/null 2>&1 || sudo apt-get install -y flatpak
    sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    for id in "${fpids[@]}"; do
        flatpak info "$id" >/dev/null 2>&1 && continue
        echo "  flatpak install: $id"
        sudo flatpak install -y --noninteractive flathub "$id" || echo "  (skip $id: install failed)"
    done
fi

# ── nerd fonts ───────────────────────────────────────────────────────────────
FONT_DIR="$HOME/.local/share/fonts"
while IFS=$'\x1f' read -r fname furl fcheck; do
    [ -z "$fname" ] && continue
    if [ -n "$fcheck" ] && [ -f "$FONT_DIR/$fcheck" ]; then continue; fi
    echo "==> font: $fname"
    mkdir -p "$FONT_DIR"
    tmp="$(mktemp -d)"
    if curl -fsSL "$furl" -o "$tmp/font.zip" && unzip -oq "$tmp/font.zip" -d "$FONT_DIR"; then
        fc-cache -f >/dev/null 2>&1 || true
    else
        echo "  (skip $fname: download or extract failed)"
    fi
    rm -rf "$tmp"
done < <(manifest list fonts name url check)

echo "==> packages done"
