#!/usr/bin/env bash
# run_onchange_after_30-editor-extensions.sh — install Cursor/VS Code extensions
# from the applied ~/.config/Cursor/extensions.txt. Delegates to the existing
# bin/cosmikase-cursor-extensions (no reimplementation). Runs after the file
# phase so the extensions list is already in place.
#
# Reruns when the extensions list changes (guarded so it never errors if the
# list is ever removed):
#   extensions-sha256: {{ if stat (joinPath .chezmoi.sourceDir "dot_config" "Cursor" "extensions.txt") }}{{ include "dot_config/Cursor/extensions.txt" | sha256sum }}{{ else }}none{{ end }}
#
# CI mode (COSMIKASE_CI=1): skipped (no editor, no GUI).
set -euo pipefail

CI="${COSMIKASE_CI:-0}"
if [ "$CI" = "1" ]; then
    echo "==> CI mode: skipping editor extensions"
    exit 0
fi

HELPER="$HOME/.local/bin/cosmikase-cursor-extensions"
[ -x "$HELPER" ] || HELPER="$(command -v cosmikase-cursor-extensions 2>/dev/null || true)"

if [ -n "$HELPER" ] && { command -v cursor >/dev/null 2>&1 || command -v code >/dev/null 2>&1; }; then
    echo "==> installing editor extensions"
    "$HELPER" install || true

    # Seed the theme's editor colors on this bootstrap too (item 4.1: the helper
    # owns editor theming). The theme is resolved at runtime from the `current`
    # symlink so this hook stays keyed on extensions.txt only — a plain theme
    # switch goes through run_onchange_after_10 and is NOT re-applied here.
    THEME_HELPER="$HOME/.local/bin/cosmikase-theme-cursor"
    [ -x "$THEME_HELPER" ] || THEME_HELPER="$(command -v cosmikase-theme-cursor 2>/dev/null || true)"
    CURRENT_LINK="$(readlink "$HOME/.local/share/cosmikase/current" 2>/dev/null || true)"
    if [ -n "$THEME_HELPER" ] && [ -n "$CURRENT_LINK" ]; then
        "$THEME_HELPER" "$(basename "$CURRENT_LINK")" --quiet --no-reload || true
    fi
else
    echo "  (cursor/code or helper not present; skipping editor extensions)"
fi
